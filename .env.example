# Root docker-compose deployment defaults.
# Copy to .env for local overrides. Replace SECRET_KEY before real deployment.

FRONTEND_PORT=3010
BACKEND_PORT=8010
POSTGRES_PORT=15432
REDIS_PORT=16379

POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app_db

DATABASE_URL=postgresql+psycopg2://app:app@postgres:5432/app_db
REDIS_URL=redis://redis:6379/0
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

MARKET_PREFETCH_INTERVAL_SECONDS=30
MARKET_PREFETCH_BATCH_LIMIT=100
MARKET_REFRESH_THROTTLE_SECONDS=30
EVENT_LIST_PAGE_SIZE=20
RANKING_TOP_N=10
EVENT_SEARCH_LIMIT=10
REALTIME_RATE_LIMIT_WINDOW=60
REALTIME_RATE_LIMIT_MAX=30
