DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5433/mydatabase
SECRET_KEY=guxiaoqianshadow
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---------------- Polymarket 数据接入（poly-data-integration） ----------------
# 默认列表后台摄取周期（秒）。
MARKET_PREFETCH_INTERVAL_SECONDS=30
# 默认列表后台摄取上限；前端仍按 EVENT_LIST_PAGE_SIZE 分页/懒加载展示。
MARKET_PREFETCH_BATCH_LIMIT=100
# 同一列表 / 单事件刷新锁窗口（秒），需与预取周期匹配避免隔轮跳过。
MARKET_REFRESH_THROTTLE_SECONDS=30

# ---------------- 分析对外 API（analysis-api） ----------------
# 默认事件列表每页返回上限。
EVENT_LIST_PAGE_SIZE=20
# 多事件排行每榜默认 TopN 截取。
RANKING_TOP_N=10
# 名称搜索默认返回候选上限。
EVENT_SEARCH_LIMIT=10
# 实时路径（搜索 / slug 解析拉取 / 明细刷新）限流窗口（秒）与窗口内阈值。
REALTIME_RATE_LIMIT_WINDOW=60
REALTIME_RATE_LIMIT_MAX=30
